{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/guard/guard.mjs\" claude"
          }
        ]
      }
    ]
  },
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(*DELETE *)",
      "Bash(*delete from*)",
      "Bash(*DROP *)",
      "Bash(*drop table*)",
      "Bash(*drop database*)",
      "Bash(*TRUNCATE*)",
      "Bash(*truncate*)",
      "Bash(*flushall*)",
      "Bash(*flushdb*)",
      "Bash(*prisma migrate reset*)",
      "Bash(*db:drop*)",
      "Bash(*migrate:fresh*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Read(.env)",
      "Read(.env.*)"
    ]
  },
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-playwright"
      ]
    }
  }
}